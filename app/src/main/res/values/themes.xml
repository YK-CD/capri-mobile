<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Capri" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/pink</item>
        <item name="android:colorPrimary">@color/pink</item>
        <item name="android:colorPrimaryDark">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/capri_mono</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="CapriButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/capri_mono</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
    <style name="CapriPinkButton" parent="CapriButton">
        <item name="android:background">@drawable/bg_button_pink</item>
        <item name="android:textColor">@color/bg_deep</item>
    </style>
    <style name="CapriLabel">
        <item name="android:textColor">@color/pink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="CapriEdit">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:fontFamily">@font/capri_mono</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
