<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPRI"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:letterSpacing="0.18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSTRUCT ONLINE"
                android:textColor="@color/green"
                android:textSize="9sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOverlay"
            style="@style/CapriButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/overlay_off"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="226dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_stage"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_bubble"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:ellipsize="end"
            android:visibility="gone" />

        <com.capri.mobile.ui.SpriteView
            android:id="@+id/sprite"
            android:layout_width="142dp"
            android:layout_height="216dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp" />
    </FrameLayout>

    <ListView
        android:id="@+id/listChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="6dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etInput"
            style="@style/CapriEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/talk"
            android:src="@drawable/ic_mic"
            android:tint="@color/green" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_pink"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_send"
            android:tint="@color/bg_deep" />
    </LinearLayout>
</LinearLayout>
