<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPRI // SETTINGS"
            android:textColor="@color/pink"
            android:textSize="17sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Construct configuration shard"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:paddingBottom="6dp" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Identity" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your name (Capri calls you this)" android:textColor="@color/muted" android:textSize="11sp"/>
        <EditText android:id="@+id/etName" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="choom" android:inputType="textPersonName" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reply language" />
        <Spinner android:id="@+id/spLanguage" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:padding="6dp" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Brain / AI" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preset (fills URL + model)" android:textColor="@color/muted" android:textSize="11sp"/>
        <Spinner android:id="@+id/spProvider" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:padding="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API base URL" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/etBaseUrl" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://api.openai.com/v1" android:inputType="textUri" android:fontFamily="monospace" android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/etModel" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="gpt-4o-mini" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API key (optional for local servers)" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/etApiKey" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="sk-…" android:inputType="textPassword" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/api_key_note" android:textColor="@color/muted" android:textSize="10sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperature" android:textColor="@color/muted" android:textSize="11sp"/>
                <EditText android:id="@+id/etTemperature" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.7" android:inputType="numberDecimal" />
            </LinearLayout>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Max tokens" android:textColor="@color/muted" android:textSize="11sp"/>
                <EditText android:id="@+id/etMaxTokens" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="160" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Voice" />
        <Switch android:id="@+id/swTts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capri speaks replies (TTS)" android:textColor="@color/text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pitch" android:textColor="@color/muted" android:textSize="11sp"/>
                <EditText android:id="@+id/etPitch" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="1.12" android:inputType="numberDecimal" />
            </LinearLayout>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="@color/muted" android:textSize="11sp"/>
                <EditText android:id="@+id/etRate" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="1.05" android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capri's cloned voice server (optional GPT-SoVITS URL)" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/etRemoteTts" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="http://192.168.1.10:9880/tts" android:inputType="textUri" android:fontFamily="monospace" android:textSize="12sp" />
        <EditText android:id="@+id/etRemotePrompt" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Reference transcript (prompt_text)" android:inputType="text" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Floating character" />
        <Switch android:id="@+id/swOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Capri above other apps" android:textColor="@color/text" />
        <Switch android:id="@+id/swRoam" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Let her wander around the screen" android:textColor="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Character height (dp)" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/etOverlaySize" style="@style/CapriEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="190" android:inputType="number" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HyperOS / Android permissions" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xiaomi HyperOS kills background apps unless you allow them. Capri needs these to stay on screen." android:textColor="@color/muted" android:textSize="11sp" android:paddingBottom="6dp"/>
        <Button android:id="@+id/btnOverlayPerm" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Allow display over other apps" android:layout_marginTop="4dp" />
        <Button android:id="@+id/btnBattery" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Disable battery optimization" android:layout_marginTop="4dp" />
        <Button android:id="@+id/btnNotification" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Allow notifications" android:layout_marginTop="4dp" />
        <Button android:id="@+id/btnAutostart" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4. HyperOS autostart settings" android:layout_marginTop="4dp" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Memory shard" />
        <TextView android:id="@+id/tvMemoryFacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp" android:lineSpacingExtra="2dp" android:paddingBottom="6dp"/>
        <Button android:id="@+id/btnClearMemory" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_memory" />
        <Button android:id="@+id/btnClearChat" style="@style/CapriButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_chat" android:layout_marginTop="4dp" />

        <TextView style="@style/CapriLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About" />
        <TextView android:id="@+id/tvAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp" android:lineSpacingExtra="3dp" />
        <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="10sp" android:paddingTop="6dp" />

        <Button android:id="@+id/btnSave" style="@style/CapriPinkButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="SAVE CONFIG" android:layout_marginTop="18dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
